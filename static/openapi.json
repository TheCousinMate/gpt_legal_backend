  "components": {
    "schemas": {
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "PrediccionInput": {
        "properties": {
          "contexto": {
            "type": "string",
            "title": "Contexto"
          }
        },
        "type": "object",
        "required": [
          "contexto"
        ],
        "title": "PrediccionInput"
      },
      "ReflexionInput": {
        "properties": {
          "documento_analizado": {
            "type": "string",
            "title": "Documento Analizado"
          },
          "criterios": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Criterios"
          }
        },
        "type": "object",
        "required": [
          "documento_analizado",
          "criterios"
        ],
        "title": "ReflexionInput"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      },
      "VisionInput": {
        "properties": {
          "image_id": {
            "type": "string",
            "title": "Image Id"
          }
        },
        "type": "object",
        "required": [
          "image_id"
        ],
        "title": "VisionInput"
      }
    }
  }
