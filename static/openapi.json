{
  "openapi": "3.1.0",
  "info": {
    "title": "Forensic Legal Cognition 4.1",
    "description": "API chilena de análisis jurídico automatizado, evaluación doctrinal y verificación forense de alta precisión.",
    "termsOfService": "https://github.com/TheCousinMate/gpt_legal_backend#terms",
    "contact": {
      "name": "Kabir K. Hazbún Crovetto",
      "url": "https://github.com/TheCousinMate/gpt_legal_backend",
      "email": "kharzun@gmail.com"
    },
    "license": {
      "name": "MIT",
      "url": "https://opensource.org/licenses/MIT"
    },
    "version": "4.1.0"
  },
  "servers": [
    {
      "url": "https://gpt-legal-backend.onrender.com",
      "description": "Servidor público en Render"
    }
  ],
  "paths": {
    "/": {
      "get": {
        "summary": "Health Check",
        "operationId": "healthCheck",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "example": "ok"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ValidationError": {
        "title": "ValidationError",
        "type": "object",
        "required": ["loc", "msg", "type"],
        "properties": {
          "loc": {
            "title": "Location",
            "type": "array",
            "items": {
              "anyOf": [
                { "type": "string" },
                { "type": "integer" }
              ]
            }
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        }
      },
      "HTTPValidationError": {
        "title": "HTTPValidationError",
        "type": "object",
        "properties": {
          "detail": {
            "title": "Detail",
            "type": "array",
            "items": {
              "": "#/components/schemas/ValidationError"
            }
          }
        }
      }
    }
  }
}
